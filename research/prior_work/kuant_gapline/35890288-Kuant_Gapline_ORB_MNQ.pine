//@version=6
// ============================================================================================
// KUANT GAPLINE ORB  --  MNQ Gap-Up Opening-Range Breakout, Long Only
// TradingView Pine Script v6 STRATEGY
// --------------------------------------------------------------------------------------------
// Instrument : MNQ (Micro E-mini Nasdaq-100), $2 per point  (CME_MINI:MNQ1!)
// Timeframe  : 1-minute chart; 5-minute signal bars are built inside the script
// Sessions   : Electronic trading hours (17:00-16:00 CT). All rule times are Chicago time.
// Backtest   : May 2019 - Oct 2026, $500 risk/trade, costs included
//   Sharpe   : 2019-22 1.32 | 2023-24 1.91 | 2025-26 0.58
//              before 2024 1.35 | 2024 onward 1.22 | whole 1.30
//   Net $52,024 | max drawdown -$4,856 | 27 configurations tried
// --------------------------------------------------------------------------------------------
// HOW TO USE
//   - Chart: CME_MINI:MNQ1! (or the front month), 1-MINUTE bars, EXTENDED trading hours ON
//     (chart settings -> Symbol -> Session: Electronic trading hours). The 17:00 re-entry and
//     the overnight EMA need the overnight bars. The chart time zone does not matter: the
//     script reads every bar in America/Chicago time.
//   - Commission $0.50 per contract per order and slippage 1 tick are preset in the
//     strategy properties.
//   - History: at least 4-5 sessions before the first trade (EMA200 on 5-minute bars). A long
//     backtest on 1-minute bars needs TradingView's Deep Backtesting.
//   - ReEntryQty: 1 = re-enter the 17:00 leg with 1 MNQ (as backtested);
//     0 = re-enter with the same size as the position flattened at 15:40.
//   - Lower MaxContracts if you stack this with other strategies on one account.
//   - Do not run it alongside S27 on the same account (highly correlated).
//   - Early-close holiday sessions have no 15:40 bar: as in the backtest, an open position is
//     then held into the 17:00 reopen. Flatten by hand on those days if your account needs it.
//
// HOW IT EXECUTES
//   1. Gap: today's RTH open (08:30 CT 1-minute open) minus the prior RTH close (last bar
//      ending by 15:00 CT) must be >= +0.5 point.
//   2. Opening range = high/low of the 5-minute bars opening 08:30, 08:35, 08:40 CT.
//   3. EMA200 of all 5-minute closes, around the clock.
//   4. Long when a 5-minute bar opening 08:45 ... 15:30 CT closes above the range high AND
//      above the EMA200, while flat -> buy at the next 1-minute open. Repeat entries the same
//      day are allowed after an exit.
//   5. Stop distance = signal close - range low. Stop = fill - distance, target = fill + 1.5 x
//      distance. Size = floor($500 / (distance x $2)), 1..40 MNQ.
//   6. 15:40 CT: flat at market, no new entries until 17:00.
//   7. 17:00 CT: re-enter the flattened trade (1 MNQ) with the SAME stop and target prices
//      (order sent on the 15:59 bar, filled at the 17:00 open).
//
// NOT RUN ON TRADINGVIEW YET: add it to a chart, check that it compiles, and compare a few
// trades with the backtest before trading. Research code, not financial advice.
// ============================================================================================
strategy("Kuant Gapline ORB (MNQ)", shorttitle = "Gapline ORB", overlay = true, pyramiding = 0,
     initial_capital = 50000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1,
     process_orders_on_close = false, calc_on_every_tick = false,
     default_qty_type = strategy.fixed, default_qty_value = 1)

// ---------- inputs (times are HHMM Chicago, bar CLOSE times as in the MultiCharts version) ----------
rngStart     = input.int(830,   "Range start (5m bar close >)",          group = "1. Opening range")
rngEnd       = input.int(845,   "Range end (5m bar close <=)",           group = "1. Opening range")
lastSigTime  = input.int(1535,  "Last signal (5m bar close <=)",         group = "1. Opening range")
emaLen       = input.int(200,   "EMA length (5m closes)", minval = 1,    group = "2. Rules")
targetR      = input.float(1.5, "Target (x stop distance, 0 = none)", minval = 0, group = "2. Rules")
longOnly     = input.bool(true, "Long only",                             group = "2. Rules")
useGapFilter = input.bool(true, "Use gap filter",                        group = "2. Rules")
gapMin       = input.float(0.5, "Min gap (points)", minval = 0,          group = "2. Rules")
rthStart     = input.int(830,   "RTH start (1m bar close >)",            group = "3. Session")
rthEnd       = input.int(1500,  "RTH end (1m bar close <=)",             group = "3. Session")
flatTime     = input.int(1540,  "Flat time",                             group = "3. Session")
riskUSD      = input.float(500,  "Risk per trade ($)", minval = 1,       group = "4. Sizing")
maxRiskUSD   = input.float(1000, "Max risk per trade ($)", minval = 1,   group = "4. Sizing")
maxContracts = input.int(40,    "Max contracts", minval = 1,             group = "4. Sizing")
reenter      = input.bool(true, "Re-enter at 17:00 after the 15:40 flat", group = "5. Lucid")
reEntryQty   = input.int(1,     "Re-entry contracts (0 = same as flattened)", minval = 0, group = "5. Lucid")

TZ = "America/Chicago"
toMin(hhmm) => math.floor(hhmm / 100) * 60 + hhmm % 100

if timeframe.period != "1"
    runtime.error("Kuant Gapline ORB runs on a 1-minute chart.")

// ---------- clock: bar OPEN minute (om) and CLOSE minute (cm), Chicago time ----------
om   = hour(time, TZ) * 60 + minute(time, TZ)
cm   = om + 1
dkey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
tick = syminfo.mintick
pv   = syminfo.pointvalue

// ---------- RTH open and prior RTH close (1-minute bars closing 08:31 ... 15:00) ----------
var int   rthDate   = 0
var float rthOpenPx = 0.0
var float lastRthC  = 0.0
var float prevRthC  = 0.0
if cm > toMin(rthStart) and cm <= toMin(rthEnd)
    if dkey != rthDate
        prevRthC  := lastRthC
        rthOpenPx := open
        rthDate   := dkey
    lastRthC := close
gapOK  = rthDate == dkey and prevRthC > 0
gapPts = gapOK ? rthOpenPx - prevRthC : 0.0

// ---------- internal 5-minute bars, EMA, opening range, signal ----------
var int   bKey     = -1
var int   bOpenMin = 0
var int   bDate    = 0
var float bH       = 0.0
var float bL       = 0.0
var float bC       = 0.0
var bool  bDone    = true
var float emaV     = 0.0
var bool  emaOn    = false
var int   rngDate  = 0
var float rngHi    = 0.0
var float rngLo    = 0.0

bool  sigL = false
bool  sigS = false
float sigC = 0.0

// a 5-minute bar whose last minute is missing is closed late, on the next bar
bool  lateClose = false
float lH = 0.0
float lL = 0.0
float lC = 0.0
int   lOpen = 0
int   lDate = 0
key = int(math.floor(time / 300000))
if key != bKey
    if not bDone and bKey >= 0
        lateClose := true
        lH := bH
        lL := bL
        lC := bC
        lOpen := bOpenMin
        lDate := bDate
    bKey     := key
    bH       := high
    bL       := low
    bOpenMin := om - om % 5
    bDate    := dkey
    bDone    := false
bH := math.max(bH, high)
bL := math.min(bL, low)
bC := close
regClose = cm % 5 == 0

for k = 0 to 1
    doIt = k == 0 ? lateClose : regClose
    if doIt
        xH    = k == 0 ? lH : bH
        xL    = k == 0 ? lL : bL
        xC    = k == 0 ? lC : bC
        xDate = k == 0 ? lDate : bDate
        t2    = (k == 0 ? lOpen : bOpenMin) + 5          // 5-minute bar close minute
        emaV  := emaOn ? emaV + 2.0 / (emaLen + 1) * (xC - emaV) : xC
        emaOn := true
        if t2 > toMin(rngStart) and t2 <= toMin(rngEnd)
            if xDate != rngDate
                rngHi   := xH
                rngLo   := xL
                rngDate := xDate
            else
                rngHi := math.max(rngHi, xH)
                rngLo := math.min(rngLo, xL)
        rngReady = xDate == rngDate and t2 > toMin(rngEnd)
        if rngReady and t2 <= toMin(lastSigTime)
            sigC := xC
            sigL := xC > rngHi and xC > emaV
            sigS := not longOnly and xC < rngLo and xC < emaV
            if useGapFilter
                if not gapOK
                    sigL := false
                    sigS := false
                else
                    if gapPts < gapMin
                        sigL := false
                    if gapPts > -gapMin
                        sigS := false
if regClose
    bDone := true

// ---------- position state ----------
d = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
lucidBlock = cm >= toMin(flatTime) and cm < 1020

var bool  wasFlat    = true
var bool  pendingNew = false
var float sdEntry    = 0.0
var float curStop    = 0.0
var float curTgt     = 0.0
var int   reDir      = 0
var int   reQty      = 1
var float reStop     = 0.0
var float reTgt      = 0.0
var bool  reWait     = false

// first bar of a new position: remember its stop / target prices (for the 17:00 re-entry)
if d != 0 and wasFlat
    wasFlat := false
    if pendingNew
        curStop := strategy.position_avg_price - d * sdEntry
        curTgt  := targetR > 0 ? strategy.position_avg_price + d * math.ceil(targetR * sdEntry / tick - 1e-9) * tick : 0.0
    pendingNew := false
if d == 0
    wasFlat := true

canTrade = true
if reWait
    reWait := false
    if d == 0
        canTrade := false

// ---------- Lucid flat at 15:40 CT, remember the trade for the 17:00 re-entry ----------
if d != 0 and lucidBlock
    if reenter and reDir == 0
        reDir  := d
        reStop := curStop
        reTgt  := curTgt
        reQty  := reEntryQty > 0 ? reEntryQty : int(math.abs(strategy.position_size))
    strategy.close_all(comment = "Lucid flat 15:40")
    canTrade := false

// ---------- 17:00 re-entry: order on the 15:59 bar (fills at the 17:00 open) ----------
if canTrade and reDir != 0 and d == 0
    if cm == 960 or (cm >= 1021 and cm < 1080)
        reId = reDir == 1 ? "GL_LR" : "GL_SR"
        curStop    := reStop
        curTgt     := reTgt
        pendingNew := false
        strategy.entry(reId, reDir == 1 ? strategy.long : strategy.short, qty = reQty)
        strategy.exit(reId + "_X", from_entry = reId, stop = reStop, limit = reTgt > 0 ? reTgt : na)
        reDir  := 0
        reWait := true
    canTrade := false

// ---------- new entries (flat, outside 15:40-17:00) ----------
if canTrade and d == 0 and reDir == 0 and not lucidBlock and (sigL or sigS)
    sd = sigL ? sigC - rngLo : rngHi - sigC
    if sd > 0
        q = int(math.floor(riskUSD / (sd * pv)))
        q := math.min(q, int(math.floor(maxRiskUSD / (sd * pv))))
        q := math.max(1, math.min(q, maxContracts))
        sdEntry := sd
        id = sigL ? "GL_L" : "GL_S"
        lossTicks   = math.max(1, math.round(sd / tick))
        profitTicks = targetR > 0 ? math.max(1, math.ceil(targetR * sd / tick - 1e-9)) : na
        strategy.entry(id, sigL ? strategy.long : strategy.short, qty = q)
        strategy.exit(id + "_X", from_entry = id, loss = lossTicks, profit = profitTicks)
        pendingNew := true

// ---------- plots ----------
showRng = rngDate == dkey and cm > toMin(rngEnd) and cm <= 900
plot(showRng ? rngHi : na, "Range high", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(showRng ? rngLo : na, "Range low",  color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plot(emaOn ? emaV : na, "EMA200 (5m)", color = color.new(color.gray, 20))
